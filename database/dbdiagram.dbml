Project campaign_service {
  database_type: "PostgreSQL"
  Note: 'Source of truth: .sql files'
}

Table campaign_categories {
  id uuid [pk, default: `gen_random_uuid()`]
  parent_id uuid [ref: > campaign_categories.id]
  code varchar(50) [unique, not null]
  name varchar(150) [not null]
  icon_url text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

Table campaigns {
  id uuid [pk, default: `gen_random_uuid()`]
  organizer_user_id uuid [not null]
  slug varchar(150) [unique, not null]
  title varchar(255) [not null]
  short_description text
  story_content text
  category_id uuid [ref: > campaign_categories.id]
  target_amount numeric(20,2) [not null]
  collected_amount numeric(20,2) [not null, default: 0]
  currency varchar(3) [not null, default: 'IDR']
  cover_image_url text
  status varchar(20) [not null, default: 'DRAFT']
  visibility varchar(20) [not null, default: 'PUBLIC']
  verification_status varchar(20) [not null, default: 'PENDING']
  started_at timestamptz
  ended_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

Table campaign_media {
  id uuid [pk, default: `gen_random_uuid()`]
  campaign_id uuid [not null, ref: > campaigns.id]
  media_type varchar(20) [not null]
  file_url text [not null]
  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
}

Table campaign_beneficiaries {
  id uuid [pk, default: `gen_random_uuid()`]
  campaign_id uuid [not null, ref: > campaigns.id]
  beneficiary_type varchar(30) [not null]
  full_name varchar(150)
  organization_name varchar(255)
  relationship varchar(100)
  bank_account_id uuid
  created_at timestamptz [not null, default: `now()`]
}

Table campaign_updates {
  id uuid [pk, default: `gen_random_uuid()`]
  campaign_id uuid [not null, ref: > campaigns.id]
  title varchar(255) [not null]
  content text [not null]
  published_at timestamptz
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

Table campaign_tags {
  campaign_id uuid [not null, ref: > campaigns.id]
  tag varchar(50) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (campaign_id, tag) [pk]
  }
}

Table campaign_statistics {
  campaign_id uuid [pk, ref: > campaigns.id]
  total_donations bigint [not null, default: 0]
  total_unique_donors bigint [not null, default: 0]
  share_count bigint [not null, default: 0]
  view_count bigint [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]
}
